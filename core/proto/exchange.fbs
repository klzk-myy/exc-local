// Task 1.3.5 — wire schema for C++ core <-> Go services IPC.
//
// All order-flow messages are carried inside the Event envelope on both the
// Aeron `aeron:ipc` channels and the shared-memory SPSC ring fallback
// (services/internal/ipc, core/src/ipc/SharedMemChannel.cpp).
//
// Conventions:
//   - qty/price are int64 scaled by 1e8 (spec fixed-point convention).
//   - Event.seq is a per-channel monotonic sequence assigned by the producer;
//     Event.ts is the producer's CLOCK_REALTIME timestamp in nanoseconds.
//   - Never HTTP/gRPC in this path (spec §2.3).

namespace exc.wire;

enum Side : ubyte { Buy = 0, Sell = 1 }

enum OrderType : ubyte { Market = 0, Limit = 1, StopMarket = 2, StopLimit = 3,
                         Iceberg = 4,
                         // Phase-16 appends — C++ decode lands with the
                         // engine sibling; enum appends are wire-safe.
                         Peg = 5, Fixing = 6 }

enum TimeInForce : ubyte { GTC = 0, IOC = 1, FOK = 2, GTD = 3, DAY = 4 }

/// Inbound: order submission from the Go gateway to the matching core.
/// Phase-02 extension fields are additive (FlatBuffers table append —
/// old writers still decode, new fields default 0).
table OrderNew {
    order_id: uint64;
    account_id: uint64;
    instrument_id: uint32;
    side: Side;
    type: OrderType;
    qty: int64;            // scaled 1e8
    price: int64;          // scaled 1e8; ignored for Market
    tif: TimeInForce;
    client_order_id: string;
    // --- Phase-02 additions (Task 2.3.2/2.3.10/2.3.11/2.3.18/2.3.26) --------
    stp_mode: ubyte;              // StpMode; 0xFF = unset -> account default
    flags: ubyte;                 // bit0 post_only, bit1 reduce_only;
                                  // bit2 hidden, bit3 gslo (Phase-16
                                  // Tasks 16.3.13/16.3.16)
    stop_price: int64;            // scaled 1e8; 0 unless STOP*/triggered types
    gtd_expiry_ns: int64;         // absolute expiry for GTD; DAY resolves
                                  // in-core via ExpiryScheduler when 0
    display_qty: int64;           // ICEBERG visible slice; 0 = engine default
    trade_group_id: uint32;       // accounts.trade_group_id (migration 072)
    discretionary_offset_pips: int64;  // Task 2.3.26; 0 = none
    // --- Phase-16 additions (Tasks 16.3.10/.11/.15/.16/.17) — written by
    //     the Go gateway; the engine sibling decodes them. Old readers
    //     observe the schema defaults (0 = feature off). ---
    peg_mode: ubyte;              // 0 none | 1 MID | 2 PRIMARY | 3 MARKET
    peg_offset: int64;            // scaled 1e8, signed
    peg_limit: int64;             // scaled 1e8; 0 = no collar
    trigger_source: ubyte;        // 0 LAST_PRICE | 1 MARK_PRICE | 2 INDEX_PRICE
    trailing_offset: int64;       // scaled 1e8; 0 = none
    trailing_offset_unit: ubyte;  // 0 none | 1 PIPS | 2 PERCENTAGE | 3 ABSOLUTE
    activation_price: int64;      // scaled 1e8; 0 = none
}

/// Inbound: cancel request.
/// `reason` is additive (Phase-14 Task 14.3.1): engine-emitted outbound
/// cancels carry the kWalCancelReason* code (0=user, 1=expired, 2=STP,
/// 3=FOK_unfilled, 4=IOC_remainder, 5=slippage, 6=exec-rule range,
/// 7=OCO sibling) so the read model can distinguish a sibling-cancelled
/// OCO leg for the OCO_SIBLING_CANCEL_RACE (409) API mapping. Inbound
/// cancel requests leave it 0/unset.
table OrderCancel {
    order_id: uint64;
    account_id: uint64;
    reason: ubyte;
}

/// Inbound: deterministic clock tick (Task 2.3.10). The matching thread turns
/// each tick into a WAL TIME_TICK entry — the gateway never writes the WAL.
table TimeTick {
    tick_ns: uint64;
}

/// Inbound: atomic amend/replace (Task 2.3.20). Single-thread total order —
/// concurrent amends on the same order_seq resolve to exactly one winner.
table OrderAmend {
    order_id: uint64;
    order_seq: uint64;          // expected engine seq — stale -> STALE_MODIFY
    price: int64;               // 0 = unchanged
    qty: int64;                 // 0 = unchanged
    stop_price: int64;          // 0 = unchanged
    gtd_expiry_ns: int64;       // 0 = unchanged
}

/// Inbound: OCO (one-cancels-other) link command — Phase-14 Task 14.3.1,
/// spec §6.2/§6.5. The gateway sends this event on the pair's shard BEFORE
/// either leg's OrderNew, so the engine installs the linkage while both
/// members are still unplaced: a leg that fills first then cancels the
/// sibling atomically, and a leg whose sibling already terminated is
/// rejected OCO_SIBLING_CANCEL_RACE on arrival (deterministic WAL order).
/// link_id is the OCO group identifier persisted as orders.oco_group_id.
table OcoLink {
    link_id: uint64;
    order_id_a: uint64;
    order_id_b: uint64;
    account_id: uint64;
    instrument_id: uint32;
}

/// Outbound: execution report emitted by the matching core.
table TradeFill {
    trade_id: uint64;
    buy_order_id: uint64;
    sell_order_id: uint64;
    price: int64;          // scaled 1e8
    qty: int64;            // scaled 1e8
    seq: uint64;           // engine sequence
}

/// One aggregated price level within a BookSnapshot.
table PriceLevel {
    price: int64;          // scaled 1e8
    qty: int64;            // scaled 1e8
    count: uint32;         // resting orders at this level
}

/// Outbound: aggregated order-book snapshot for market data fan-out.
table BookSnapshot {
    instrument_id: uint32;
    seq: uint64;
    bids: [PriceLevel];
    asks: [PriceLevel];
}

/// Outbound: auction phase transition / indicative update — Phase-15
/// (spec §7.3 reopening call auction). Emitted on every committed phase
/// transition and when the indicative clearing pair (price,qty) changes
/// during CALL accumulation.
///   phase:  0=CALL 1=EXTEND 2=UNCROSS 3=CANCEL 4=QUARANTINE
///           5=STRIKE_FAILED (deadline struck, no clearing price formed)
///   signal: 0=indicative update, 1=uncross committed, 2=deadline extended,
///           3=clearing failed/quarantined, 4=crossed-book quarantine
///   auction_id: opaque id of the armed CALL (the armed deadline ns value).
///   imbalance: signed buy-minus-sell eligible qty at the indicative price.
table AuctionEvent {
    instrument_id: uint32;
    auction_id: uint64;
    phase: ubyte;
    signal: ubyte;
    indicative_price: int64;   // scaled 1e8
    indicative_qty: int64;     // scaled 1e8
    imbalance: int64;          // scaled 1e8 (buy-side surplus when > 0)
    deadline_ns: int64;
    cleared_qty: int64;        // scaled 1e8 (UNCROSS rows; 0 elsewhere)
}

/// Outbound: one order-level (L3) lifecycle event — Phase-17 Task 17.3.1,
/// spec §11. Emitted by the matching core ONLY after the triggering
/// mutation is WAL-committed: wal_seq is that row's sequence, giving the
/// read model a 1:1-verifiable L3 <-> journal correlation (spec §24 #318).
/// A single WAL row may produce multiple L3 events sharing its wal_seq
/// (e.g. a TRADE row yields maker + taker Fill events; an ingress row may
/// yield Add + Fill + remainder Cancel); every emitted event then carries
/// the seq of the row that caused it.
///
///   account_hash: stable pseudonym, NEVER the raw account id — salted
///                 FNV-1a-64, see exch::L3Publisher::hash_account
///                 (salt literal "exc.l3.account.v1").
///   qty:          order-level remaining qty AFTER the event (scaled 1e8;
///                 Cancel -> 0; for ICEBERG orders this is the full hidden
///                 reserve remaining, not the visible slice).
///   qty_delta:    signed remaining-qty change applied by this event:
///                 +qty on Add, -fill on Fill, -cancelled remainder on
///                 Cancel, signed delta on a qty Modify, 0 on a
///                 price-only Modify / PEG reprice.
///   price:        order price after the event (scaled 1e8); the fill
///                 print on Fill; the new resting price on a PEG reprice.
///   ref_price:    pending conditional trigger price (stop/trailing-arm
///                 orders) when carried by the triggering WAL row; else 0.
///   seq:          per-instrument monotonic L3 sequence (spec §11.1) —
///                 1-BASED (0 is the flatbuffers absent-field sentinel and
///                 is contract-invalid); assigned at emission and consumed
///                 even when transport send fails, so consumers detect loss
///                 as a gap and resync via snapshot.
///   fill_role:    Fill only: 1 = taker leg, 2 = maker leg, 3 = auction
///                 uncross leg; 0 elsewhere.
///   flags:        bit0 hidden (not L2-visible: hidden flag or PEG),
///                 bit1 pegged, bit2 synthetic venue leg (GSLO paired),
///                 bit3 iceberg order, bit4 detail present (side/price/
///                 qty populated; a Cancel may legitimately carry 0 when
///                 the order context is unresolvable).
///   cancel_reason: Cancel only — kWalCancelReason* code (0 user,
///                 1 expired, 2 STP, 3 FOK unfilled, 4 IOC remainder,
///                 5 slippage, 6 exec-rule, 7 OCO sibling); 0 elsewhere.
///   kind + per-symbol seq + wal_seq let consumers and the §24 #318 audit
///   reconcile L3 against the journal without trusting timestamps.
enum L3EventKind : ubyte { Add = 0, Modify = 1, Cancel = 2, Fill = 3 }

table L3OrderEvent {
    instrument_id: uint32;
    kind: L3EventKind;
    order_id: uint64;
    account_hash: uint64;
    side: Side;
    price: int64;            // scaled 1e8
    ref_price: int64;        // scaled 1e8; pending-conditional trigger
    qty: int64;              // scaled 1e8 — remaining AFTER the event
    qty_delta: int64;        // scaled 1e8 — signed change applied
    seq: uint64;             // per-instrument L3 sequence
    wal_seq: uint64;         // triggering WAL row seq (§24 #318)
    trade_id: uint64;        // Fill only; 0 elsewhere
    fill_role: ubyte;
    flags: ubyte;
    cancel_reason: ubyte;
}

// Union members are APPEND-ONLY: discriminants are wire-embedded ordinals —
// inserting mid-union renumbers TradeFill/BookSnapshot and breaks compat.
// L3OrderEvent appended for Phase-17 Task 17.3.1 -> EventType_L3OrderEvent=9.
union EventType { OrderNew, OrderCancel, TradeFill, BookSnapshot, TimeTick,
                  OrderAmend, OcoLink, AuctionEvent, L3OrderEvent }

/// Envelope for every IPC message. `type_type` carries the discriminator.
table Event {
    seq: uint64;
    ts: uint64;
    type: EventType;
}

root_type Event;
