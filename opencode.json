{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": ["/usr/bin/gitnexus", "mcp"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem@2026.8.31", "/www/wwwroot/exc.local"],
      "enabled": true
    },
    "git-history": {
      "type": "local",
      "command": ["npx", "-y", "mcp-server-git-history@1.1.1"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory@2026.8.31"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking@2026.8.31"],
      "enabled": true
    },
    "time": {
      "type": "local",
      "command": ["npx", "-y", "@guanxiong/mcp-server-time@1.0.0"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["npx", "-y", "mcp-server-fetch-typescript@0.1.1"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github@2025.4.8"],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres@0.6.2", "{env:POSTGRES_CONNECTION_STRING}"],
      "enabled": true
    },
    "redis": {
      "type": "local",
      "command": ["npx", "-y", "@gongrzhe/server-redis-mcp@1.0.0", "{env:REDIS_URL}"],
      "enabled": true,
      "environment": {
        "REDIS_URL": "{env:REDIS_URL}"
      }
    },
    "clickhouse": {
      "type": "local",
      "command": ["npx", "-y", "@arvoretech/clickhouse-mcp@1.0.0"],
      "enabled": false,
      "environment": {
        "CLICKHOUSE_URL": "{env:CLICKHOUSE_URL}",
        "CLICKHOUSE_USER": "{env:CLICKHOUSE_USER}",
        "CLICKHOUSE_PASSWORD": "{env:CLICKHOUSE_PASSWORD}",
        "CLICKHOUSE_DATABASE": "{env:CLICKHOUSE_DATABASE}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.82"],
      "enabled": true
    }
  }
}
