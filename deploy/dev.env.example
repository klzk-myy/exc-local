# Dev-stack environment for the gateway + daemons (docker-compose.dev.yml).
# Copy to deploy/dev.env (gitignored) and source it before launching:
#   set -a; . deploy/dev.env; set +a; ./bin/gateway
# Values match the compose services — no real secrets belong here.

# --- API auth ---
# HS256 dev signing key (32-byte min). Matches tests/pentest harness.
EXC_JWT_HS256_KEY_B64=cGVudGVzdC1rZXktMzItYnl0ZXMtc3VmZmljaWVudCEh

# --- ClickHouse analytics (native protocol :9000) ---
# ConfigFromEnv rewrites :8123 → :9000 when only EXC_CH_URL is set.
EXC_CH_URL=127.0.0.1:9000
EXC_CH_DATABASE=exchange_analytics
EXC_CH_USER=exchange
EXC_CH_PASSWORD=exchange_dev

# --- Coordination Redis (direct mode, db 0) ---
# Sentinel HA mode instead uses config/redis-sentinel.yaml (db 9) —
# do not mix keyspaces between modes.
EXC_REDIS_ADDR=127.0.0.1:16379
EXC_REDIS_DB=0

# --- NATS JetStream cluster seeds ---
EXC_NATS_URLS=nats://127.0.0.1:4222,nats://127.0.0.1:4223,nats://127.0.0.1:4224
