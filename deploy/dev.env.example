# Dev-stack environment for the gateway + daemons (docker-compose.dev.yml).
# Copy to deploy/dev.env (gitignored) and source it before launching:
#   set -a; . deploy/dev.env; set +a; ./bin/gateway
# Values match the compose services — no real secrets belong here.

# --- API auth ---
# HS256 dev signing key (32-byte min). Matches tests/pentest harness.
EXC_JWT_HS256_KEY_B64=cGVudGVzdC1rZXktMzItYnl0ZXMtc3VmZmljaWVudCEh

# --- ClickHouse analytics (native protocol :9000) ---
# ConfigFromEnv rewrites :8123 → :9000 when only EXC_CH_URL is set.
EXC_CH_URL=127.0.0.1:9000
EXC_CH_DATABASE=exchange_analytics
EXC_CH_USER=exchange
EXC_CH_PASSWORD=exchange_dev

# --- Coordination Redis (direct mode, db 0) ---
# Sentinel HA mode instead uses config/redis-sentinel.yaml (db 9) —
# do not mix keyspaces between modes.
EXC_REDIS_ADDR=127.0.0.1:16379
EXC_REDIS_DB=0

# --- NATS JetStream cluster seeds ---
EXC_NATS_URLS=nats://127.0.0.1:4222,nats://127.0.0.1:4223,nats://127.0.0.1:4224

# --- Edge rate limiter ---
# The vite dev/preview proxy shards XFF per route (frontend/vite.config.ts)
# so each REST surface gets its own §8.8 bucket. Without this the gateway
# keys every proxied call on 127.0.0.1 and the shared 5 rps Public bucket
# 429s the SPA under normal use.
EXC_TRUST_PROXY=1

# --- Sanctions screening (dev fixture lists) ---
# Wires the gateway ListScreener + exc:sanctions:feed:heartbeat publisher
# so the core's check-0c cache is verifiable. Without this every order is
# rejected SANCTIONS_SERVICE_UNAVAILABLE (fail closed).
EXC_SANCTIONS_LIST_DIR=deploy/security/sanctions-dev

# --- Stack identity (must match every dev_stack.sh invocation) ---
# dev_stack.sh supervises daemons via pid files under RUN_DIR and binds
# shm rings under SHM_BASE. Start/stop/status only agree when these are
# pinned here — a stop run against the shared defaults silently no-ops
# on a stack launched with per-user values. The per-user run dir and the
# exc_ipc_dev ring namespace also stay clear of the root-owned
# exchange_ipc_* rings the docker app-tier engines create on host /dev/shm.
EXC_DEV_RUN_DIR="/tmp/exc-dev-stack-${USER:-dev}"
EXC_SHM_BASE=exc_ipc_dev

# --- Matching-engine idle tuning (docker app tier) ---
# EXC_ENGINE_IDLE_NS: empty-cycle park duration. 100µs keeps dev CPU near
# zero; 0 restores busy-poll for latency benchmarking.
# EXC_ENGINE_TICK_NS: on_time_tick cadence. Each tick stamps a durable
# TIME_TICK WAL entry and the 1ms flush window makes tick rate == fsync
# rate, so the 1ms production default writes ~MB/s per shard on idle.
# 50ms keeps GTD/DAY expiry and auction sweeps correct for dev while
# cutting WAL writes ~50x. Set 1000000 for production-grade 1ms ticks.
EXC_ENGINE_IDLE_NS=100000
EXC_ENGINE_TICK_NS=50000000
