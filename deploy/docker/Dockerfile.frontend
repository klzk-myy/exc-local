# Dockerfile.frontend — Trader UI image (full-project docker, 2026-10-02).
#
# Vite React build served by nginx with /api + /ws reverse-proxied to the
# gateway service on the shared exc-dev network, so the UI works against the
# containerized stack with zero host ports except :3000. Canonical frontend
# deployment stays CDN (spec §19.1); this image is the single-host dev/ops
# alternative. The `npm run build` gate (tsc + bundle-size ≤300 kB gzipped)
# runs inside the build — an oversized bundle fails the image, not review.
#
# Build (from repo root):
#   docker build -f deploy/docker/Dockerfile.frontend -t exc-frontend:local .

FROM node:22-bookworm-slim AS builder

WORKDIR /app/repo/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# gen:validators reads the checked-in spec artifact at a repo-relative
# path (frontend/../docs/openapi/openapi.json) — mirror the layout.
COPY docs/openapi/openapi.json ../docs/openapi/openapi.json
RUN npm run build

FROM nginx:stable-alpine AS runtime

# Main conf loads ngx_http_js_module (main-context only); edge.js
# supplies the per-request/per-connection XFF IPs used by
# conf.d/default.conf. Security/cache headers are GENERATED at build
# time from the canonical contract frontend/public/_headers (see
# gen-nginx-headers.sh) — no second copy of the policy to drift.
COPY deploy/docker/frontend.nginx-main.conf /etc/nginx/nginx.conf
COPY deploy/docker/frontend.edge.js /etc/nginx/edge.js
COPY deploy/docker/frontend.nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/docker/gen-nginx-headers.sh /tmp/gen-nginx-headers.sh
COPY frontend/public/_headers /tmp/_headers
RUN sh /tmp/gen-nginx-headers.sh /tmp/_headers /etc/nginx
COPY --from=builder /app/repo/frontend/dist /usr/share/nginx/html

EXPOSE 3000
