# redis-sentinel@<node>.service — Sentinel daemon (§4.5, §19.13.1).
# Instance %i = 1|2|3; config deploy/sentinel/sentinel-%i.conf.
[Unit]
Description=Redis Sentinel node %i (exchange coordination)
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=2s
Restart=always
RestartSec=1s
KillMode=mixed
TimeoutStopSec=10s

User=redis
Group=redis

ExecStart=/usr/bin/redis-sentinel /etc/redis/sentinel-%i.conf

LimitNOFILE=65536
MemoryMax=256M

PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/redis-sentinel /var/log/redis /run/redis-sentinel
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

SyslogIdentifier=redis-sentinel-%i

[Install]
WantedBy=multi-user.target
