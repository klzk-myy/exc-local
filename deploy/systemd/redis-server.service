# redis-server.service — coordination Redis data node (§19.13.1).
# Config: deploy/redis/redis.conf (AOF everysec, noeviction, 512MB backlog,
# min-replicas-to-write 1 / max-lag 5 — the RPO≤5s contract).
# Replica role set via /etc/redis/replicaof.conf include (provisioned per
# node); sentinel promotion rewrites it automatically.
[Unit]
Description=Redis coordination server (exchange)
After=network-online.target
Wants=network-online.target
Before=redis-sentinel@.service

[Service]
# redis 7 supports sd_notify READY=1.
Type=notify
NotifyAccess=main
# Go-service-tier value (Task 9.3.28).
WatchdogSec=2s
Restart=always
RestartSec=1s
KillMode=mixed
# AOF fsync drain; keep replication window.
TimeoutStopSec=30s

User=redis
Group=redis

ExecStart=/usr/bin/redis-server /etc/redis/redis.conf --supervised systemd

LimitNOFILE=1048576
LimitCORE=infinity
# maxmemory 4gb + fork/COW headroom.
MemoryMax=4500M
OOMScoreAdjust=-700

PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/redis /var/log/redis /run/redis
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

SyslogIdentifier=redis-server

[Install]
WantedBy=multi-user.target
