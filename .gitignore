# Syncthing conflict copies - never commit quarantines
*.sync-conflict-*

# Per-device tool caches - machine-local, never share or version
.gitnexus/
.mimocode/
.freebuff/
.claude/

# MCP local-scope config may contain secrets - never commit
.devin/mcp_config.local.json

# Hosting panel artifact - not part of the repo
.user.ini

# Build outputs
core/build/
build/
node_modules/

# CMake build trees (any depth)
core/build*/
**/build/
ci/fault-injection/fault

# Engine runtime artifacts (journal + poison log + snapshot dir in cwd)
/wal/
/snapshots/
poison_pill.log
*.wal

# Soak/failover run evidence (regenerated by tests/soak/monitor.sh --artifacts)
# Bulk output (trial dirs, logs, loadgen reports, samples) stays ignored;
# small report files are tracked as checkpoint evidence (spec P02.5 corpus
# discharges on committed artifacts — same pattern as tests/load/results/).
tests/soak/artifacts/*
!tests/soak/artifacts/20260928T022857Z-failover/
tests/soak/artifacts/20260928T022857Z-failover/*
!tests/soak/artifacts/20260928T022857Z-failover/failover-report.json
!tests/soak/artifacts/20260928T022857Z-failover/report.md
!tests/soak/artifacts/20260928T022857Z-failover/trials.jsonl
!tests/soak/artifacts/20260928T103724Z-shard0-8h/
tests/soak/artifacts/20260928T103724Z-shard0-8h/*
!tests/soak/artifacts/20260928T103724Z-shard0-8h/soak-report.json
!tests/soak/artifacts/20260928T103724Z-shard0-8h/report.md
!tests/soak/artifacts/20260928T103724Z-shard0-8h/events.jsonl
!tests/soak/artifacts/20260928T103724Z-shard0-8h/audits.jsonl
!tests/soak/artifacts/20260928T103724Z-shard0-8h/final-audit.json
# Built loadgen binary (rebuild: cd tests/soak && go build -o loadgen .)
tests/soak/loadgen
tests/soak/soak
# loadgen default report path when run without -report
tests/soak/*report*.json

# Local runtime dirs/binaries from manual engine/CLI runs
# (services/<daemon> binaries are ignored by services/.gitignore — one entry
# per services/cmd/<name>; regenerate with `ls cmd/ | sed 's|^|/|'`)
/snap/
deploy/haproxy/test/stub_go
deploy/haproxy/test/run/

# Phase-08 load-test artifacts — run reports are tracked evidence
# (dir must not be excluded itself or children can't be re-included):
tests/load/results/*
!tests/load/results/phase08-run1/
tests/load/results/phase08-run1/*
!tests/load/results/phase08-run1/report.json
!tests/load/results/phase08-run1/report.md
!tests/load/results/phase08-run1/README.md
tests/load/snapshots/

# Phase-13.5 Task 13.5.3.9 SBOM artifacts (regenerated: scripts/ci/gen_sbom.sh,
# deploy/crons/sbom-scan.sh nightly)
reports/sbom/
tests/load/errblast/errblast

# Compiled test binaries + coverage/profile artifacts
*.test
coverage.out
*.coverprofile
*.prof
perf.data*

# C++ objects + core dumps (vendored .a libs in core/third_party stay tracked)
*.o
*.so
*.core
vgcore.*

# Python caches (scripts/ci + scripts/security generators)
__pycache__/
*.pyc
.pytest_cache/

# Editor/OS cruft + merge leftovers
*.swp
*.swo
*~
*.orig
*.bak
*.tmp
.DS_Store
Thumbs.db
.idea/
.vscode/
*.code-workspace
nohup.out

# ctest runtime dirs — root Testing/* stubs are tracked evidence;
# this guards against new runs leaking Testing/ trees elsewhere
Testing/

# Env files + private keys — secrets must never be committed
# (kind-overlay's throwaway secrets.yaml stays tracked deliberately)
.env
.env.*
*.env
*.key
.envrc
.direnv/
!.env.example
!.env.sample
!*.env.example

# Per-device IDs (also excluded via .git/info/exclude; listed for all clones)
.mimocode-project-id

# Other per-device agent/tool caches — same class as .claude/.gitnexus/.mimocode
.reasonix/
.cursor/
.codeium/
.windsurf/
.opencode/
.aider*
.continue/
.junie/
.trunk/
.fleet/

# JS/TS artifacts outside frontend/ too (frontend/.gitignore covers its own)
dist/
coverage/
*.tsbuildinfo
.eslintcache
.stylelintcache
.vite/
.nyc_output/
playwright-report/
test-results/
npm-debug.log*
yarn-error.log
pnpm-debug.log*

# Python envs (scripts/ci, scripts/security generators)
venv/
.venv/

# Report/build byproducts not already tracked as evidence
*.sarif
junit*.xml
/out/
/tmp/
*.patch
*.diff
desktop.ini
*.iml

# Runtime dirs when binaries are launched from a module cwd
# (root /wal/, /snapshots/, /snap/ already covered above)
core/wal/
core/snapshots/
core/snap/
services/wal/
services/snapshots/
/bin/

# Root meta-docs are internal working/agent docs — kept local, not published.
# Public surface is README.md + docs/ + source.
# Exception: AGENTS.md is the standard agent entry point — fresh clones need
# the repo state + working rules it carries, so it is tracked.
!AGENTS.md
ARCHITECTURE.md
CHANGELOG.md
CLAUDE.md
CONTEXT.md
DESIGN.md
IMPLEMENTATION_PROMPT.md
MEMORY.md
WORKFLOWS.md

# Build byproducts accidentally committed
/Testing/
tests/spec/exchange-testspec
tests/chaos/bin/

# DR drill chaos evidence — bulk run dirs regenerable; results.jsonl +
# report + small logs remain committed as the DORA artifact
docs/incidents/drills/*/evidence/chaos/

# DR drill per-leg workdirs (staged WAL copies, restored segments — bulk,
# regenerable; reports + results.jsonl + small logs stay committed)
docs/incidents/drills/*/evidence/d[0-9]*/
