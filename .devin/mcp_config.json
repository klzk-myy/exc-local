{
  "mcpServers": {
    "gitnexus": {
      "command": "/home/luzenkock/.npm-global/bin/gitnexus",
      "args": ["mcp"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2026.8.31", "/www/wwwroot/exc.local"]
    },
    "git-history": {
      "command": "npx",
      "args": ["-y", "mcp-server-git-history@1.1.1"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory@2026.8.31"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking@2026.8.31"]
    },
    "time": {
      "command": "npx",
      "args": ["-y", "@guanxiong/mcp-server-time@1.0.0"]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "mcp-server-fetch-typescript@0.1.1"]
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "command": "sh",
      "args": ["-c", "GITHUB_PERSONAL_ACCESS_TOKEN=\"$(awk '/oauth_token/ {print $2; exit}' \"$HOME/.config/gh/hosts.yml\")\" exec $HOME/.local/bin/github-mcp-server stdio"]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres@0.6.2", "${env:POSTGRES_CONNECTION_STRING}"]
    },
    "redis": {
      "command": "npx",
      "args": ["-y", "@gongrzhe/server-redis-mcp@1.0.0", "${env:REDIS_URL}"],
      "env": {
        "REDIS_URL": "${env:REDIS_URL}"
      }
    },
    "clickhouse": {
      "command": "npx",
      "args": ["-y", "@arvoretech/clickhouse-mcp@1.0.0"],
      "env": {
        "CLICKHOUSE_URL": "http://127.0.0.1:8123",
        "CLICKHOUSE_USER": "exchange",
        "CLICKHOUSE_PASSWORD": "exchange_dev",
        "CLICKHOUSE_DATABASE": "exchange_analytics",
        "CLICKHOUSE_REQUEST_TIMEOUT": "30000"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.82"]
    }
  }
}
